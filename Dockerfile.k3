# K3 distribution image: COPY the already-built host executable; never rebuild it.
# Alpine includes the ca-certificates bundle. No mutable apk repositories or RUN
# instructions are needed, so arm64 packaging needs no QEMU/binfmt installation.
FROM alpine:3.23.4@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11
ARG TARGETARCH
COPY --chmod=0755 linux/${TARGETARCH}/iron-proxy /usr/local/bin/iron-proxy
ENTRYPOINT ["/usr/local/bin/iron-proxy"]
